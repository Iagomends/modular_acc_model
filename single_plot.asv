% Load data
data = load('TDT_06_M086_P60.mat');
disp(fieldnames(data)); % Show available variables

% Select data
y = data.data.accel_pedal;
t = 1:length(y);
t = t/1000;

% Plot
figure;
plot(t, y, 'b-', 'LineWidth', 1.5);

xlabel('Time [s]');
ylabel('Pedal [%]');
legend('Pedal', 'Location', 'northwest');

xlim([1 7]);          % X-axis limits
ylim([0 100]);           % Y-axis limits

grid on;
ax = gca;